          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a customer support ticket classifier. Analyze the following support ticket and respond with ONLY a valid JSON object (no markdown, no explanation) in this exact format:\n{\"category\": \"billing\" | \"bug\" | \"feature_request\" | \"general\", \"priority\": \"P1\" | \"P2\" | \"P3\" | \"P4\", \"reasoning\": \"brief one-line reason\"}\n\nPriority guide: P1 = critical/urgent (system down, payment failed, security issue), P2 = high (major feature broken), P3 = medium (minor issue, workaround exists), P4 = low (question, cosmetic issue).\n\nTicket Subject: {{ $json.subject }}\nTicket Description: {{ $json.description }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        208,
        0
      ],
      "id": "64c4e05c-8c0a-4e26-94e3-80838b62ceed",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "s4UgG0jBcvWWZm65",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const triggerData = $('Triggered by Ticket Creation').first().json;\nconst results = [];\n\nfor (const item of $input.all()) {\n  let text = item.json.content.parts[0].text;\n  text = text.trim();\n\n  if (text.startsWith(\"```\")) {\n    text = text.split(\"```\")[1];\n    if (text.startsWith(\"json\")) {\n      text = text.slice(4);\n    }\n  }\n\n  const parsed = JSON.parse(text.trim());\n\n  results.push({\n    json: {\n      ticket_id: triggerData.ticket_id,\n      customer_email: triggerData.customer_email,\n      subject: triggerData.subject,\n      description: triggerData.description,\n      category: parsed.category,\n      priority: parsed.priority,\n      reasoning: parsed.reasoning\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
