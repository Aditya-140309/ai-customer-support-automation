    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst total = items.length;\nconst byCategory = {};\nconst byPriority = {};\n\nfor (const item of items) {\n  const cat = item.json.category || \"unclassified\";\n  const pri = item.json.priority || \"unclassified\";\n  byCategory[cat] = (byCategory[cat] || 0) + 1;\n  byPriority[pri] = (byPriority[pri] || 0) + 1;\n}\n\nconst summary = `Total Tickets: ${total}\\nBy Category: ${JSON.stringify(byCategory)}\\nBy Priority: ${JSON.stringify(byPriority)}`;\n\nreturn [{ json: { summary, total, byCategory, byPriority } }];"
      },
